# Dependencies
node_modules/

# Local runtime configuration — holds real Power Automate SAS URLs.
# A SAS URL is a credential; never commit these. Copy the matching
# config.example.js and fill it in locally instead.
config/config.local.js
document-portal/config.local.js

# Ad-hoc runtime state exports
*.state.json

# Local development server store, only if DGO_DEV_DATA points it back in here.
# By default it lives outside the repository and this entry is unused.
.devdata/

# Test output
test-results/
playwright-report/
blob-report/
.playwright/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

