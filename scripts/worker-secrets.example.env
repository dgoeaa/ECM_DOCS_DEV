# NITDA DGO — Worker secrets.
#
# HOW TO USE
#   cp scripts/worker-secrets.example.env ~/dgo-secrets.env
#   # fill in the values below
#   ./scripts/set-worker-secrets.sh ~/dgo-secrets.env
#
# Copy it OUT of the repository first. This file will hold every flow trigger URL and both
# signing secrets — a flow trigger URL is a bearer credential, so anyone holding one can run
# that flow. The script refuses to read this file from inside the repository for that reason.
#
# Delete it once `curl <worker-url>/healthz` reports what Part G expects.
#
# Format: NAME=value, one per line. No spaces around the `=`. Quotes are optional.
# Leave a line blank or commented out to skip that secret.


# ══════════════════════════════════════════════════════════════════════════════════════
# REQUIRED — the proxy refuses to serve without all six
# ══════════════════════════════════════════════════════════════════════════════════════

# Your Cloudflare Access team domain, WITHOUT https://
#   Zero Trust → Settings → Custom Pages
#   e.g. nitda-dgo.cloudflareaccess.com
DGO_TENANT_ID=

# The Access application's Audience (AUD) tag — 64 hex characters
#   Zero Trust → Access → Applications → NITDA DGO Platform → Overview
DGO_AUDIENCE=

# The same team domain, WITH https:// and no trailing slash
#   e.g. https://nitda-dgo.cloudflareaccess.com
DGO_ISSUER=

# Where Access publishes its signing keys: the team domain + /cdn-cgi/access/certs
#   e.g. https://nitda-dgo.cloudflareaccess.com/cdn-cgi/access/certs
DGO_JWKS_URI=

# Cloudflare Access puts group membership in `groups`, not `roles`. Leave this as-is.
DGO_ROLES_CLAIM=groups

# Maps each Access group to a platform role. Keep it on ONE line.
# The names on the left must match your Access group names character for character.
DGO_ROLE_MAP={"DGO-SystemAdmin":"systemAdmin","DGO-UserAdmin":"userAdmin","DGO-Executive":"executive","DGO-Director":"director","DGO-Operator":"operator","DGO-Viewer":"viewer"}


# ══════════════════════════════════════════════════════════════════════════════════════
# CORE — the six endpoints a correspondence pilot needs
# ══════════════════════════════════════════════════════════════════════════════════════

# EVERY governed write in the platform goes through this one endpoint: registering
# correspondence, triage, treatment, approvals, dispatch, closure and archive. If you set
# only one endpoint, set this one.
DGO_ENDPOINT_DYNAMIC_ACTIONS=

# Loads the register when the platform starts. Without it every officer sees an empty
# platform and works on a private copy in their own browser.
DGO_ENDPOINT_FETCH_ALL=

# Assigning work to an officer, and to several at once.
DGO_ENDPOINT_SINGLE_ASSIGNMENT=
DGO_ENDPOINT_BULK_ASSIGNMENT=

# The public channel. Without INTAKE_SUBMISSION a citizen's submission gets a reference and
# is audited, but never reaches the registry — the response says delivered:false.
DGO_ENDPOINT_INTAKE_SUBMISSION=
DGO_ENDPOINT_INTAKE_UPLOAD=


# ══════════════════════════════════════════════════════════════════════════════════════
# OPTIONAL — add any of these later, one command each, no redeploy
# ══════════════════════════════════════════════════════════════════════════════════════

# Lets a citizen track their submission. Without it the tracking page answers "unavailable"
# rather than "not found" — honest, but not much use to them.
DGO_ENDPOINT_INTAKE_STATUS=

# Signs upload tickets. Without it PUT /intake/upload answers 503 and attachments cannot be
# uploaded at all. Generate with: openssl rand -base64 48
DGO_UPLOAD_SECRET=

# Signs email verification proofs. Only needed if you set DGO_REQUIRE_VERIFICATION=true in
# proxy/wrangler.toml. Must be DIFFERENT from DGO_UPLOAD_SECRET.
DGO_VERIFY_SECRET=

# Email verification before a reference is issued.
DGO_ENDPOINT_INTAKE_VERIFY_EMAIL=

# The public help desk.
DGO_ENDPOINT_INTAKE_SUPPORT=

# Registry counter scan deposits. Falls back to INTAKE_UPLOAD when unset, so one library
# serves both channels. Set it only to file counter deposits separately.
DGO_ENDPOINT_SCAN_UPLOAD=

# The outward correspondence email desk.
DGO_ENDPOINT_EMAIL=
DGO_ENDPOINT_EMAIL_RELATED_TASK=

# Additional read paths.
DGO_ENDPOINT_FETCH_ACTIVITIES=
DGO_ENDPOINT_SUBSIDIARY_ACTIONS=
DGO_ENDPOINT_REFERENCE_DATA=
DGO_ENDPOINT_GET_DOCS=
DGO_ENDPOINT_FETCH_EMAIL_ATTACHMENTS=
DGO_ENDPOINT_BULK_ASSIGNMENT_DIRECT=

# AI assistance.
DGO_ENDPOINT_AI_EMAIL_ANALYSIS=
DGO_ENDPOINT_AI_DOC_ANALYSIS=
DGO_ENDPOINT_AI_CHAT=

# One-time passcodes.
DGO_ENDPOINT_OTP_GENERATE=
DGO_ENDPOINT_OTP_VERIFY=
