# Power Automate HTTP-trigger URLs — one per endpoint contract key.
#
#   cp scripts/endpoints.example.env ~/dgo-endpoints.env
#   # fill it in, then:
#   node scripts/setup-endpoints.mjs --from ~/dgo-endpoints.env
#
# ─────────────────────────────────────────────────────────────────────────────
# THIS FILE BECOMES A CREDENTIAL THE MOMENT YOU FILL IT IN.
#
# A SAS-signed Power Automate URL authorises invoking the flow by possession
# alone — there is no second factor and no identity check. Anyone holding one of
# these lines can run that flow against the live registry.
#
# So: keep the filled-in copy OUTSIDE this repository (a home directory is
# fine), and delete it once the endpoints are wired. `setup-endpoints.mjs`
# refuses to read a filled-in copy from inside the working tree for exactly this
# reason. The generated config/config.local.js is git-ignored, but a stray
# .env in the tree is how a signature ends up in a commit.
# ─────────────────────────────────────────────────────────────────────────────
#
# Leave a line blank to skip that endpoint. Skipped endpoints simply do not
# resolve; the modules that need them report it rather than failing silently, so
# you can bring the flows up a few at a time.
#
# Lines beginning with # are ignored. Do not quote the values.

# ── Reads. These are what the platform loads on boot; wire them first.
FETCH_ALL=
FETCH_ACTIVITIES=
REFERENCE_DATA=
GET_DOCS=
FETCH_EMAIL_ATTACHMENTS=

# ── Assignment
SINGLE_ASSIGNMENT=
BULK_ASSIGNMENT=
BULK_ASSIGNMENT_DIRECT=

# ── Governed writes. DYNAMIC_ACTIONS carries most operations; the platform's
#    DISPATCH_OUTBOUND and ARCHIVE_REFERENCE contracts route through it too, so
#    they need no separate URL.
DYNAMIC_ACTIONS=
EMAIL=
EMAIL_RELATED_TASK=

# ── AI. Optional — the Assistant and analysis surfaces degrade without them.
AI_EMAIL_ANALYSIS=
AI_DOC_ANALYSIS=
AI_CHAT=

# ── Step-up confirmation for high-authority actions.
OTP_GENERATE=
OTP_VERIFY=

# ── The multi-route flow behind Activities and the email desk.
SUBSIDIARY_ACTIONS=
