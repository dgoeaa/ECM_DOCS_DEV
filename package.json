{
  "name": "dgo-r11-ui-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "DGO R11.6 runtime UI contracts, Playwright smoke tests, and dev-server tooling.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "http-server . -p 8080 --cors -c-1 --silent",
    "setup": "node scripts/setup.mjs",
    "go": "npm run setup && npm start",
    "serve:portal": "http-server document-portal -p 8080 --cors -c-1 --silent",
    "commission": "node scripts/commission-check.mjs",
    "recover": "node scripts/setup.mjs --recover --force",
    "verify:endpoints": "node scripts/verify-endpoints.mjs",
    "test": "npm run test:imports && npm run test:secrets && npm run test:exposure && npm run test:governance && npm run test:encoding && npm run test:hardening && npm run test:references && npm run test:categories && npm run test:filenames && npm run test:register && npm run test:normalizer && npm run test:flags && npm run test:entrypoints && npm run test:triage && npm run test:visual && npm run test:architecture && npm run test:auth && npm run test:commissioning && npm run test:smoke",
    "test:commissioning": "node tests/commissioning.test.mjs",
    "test:auth": "node tests/auth-posture.test.mjs",
    "test:encoding": "node tests/output-encoding.test.mjs",
    "test:governance": "node tests/governance.test.mjs",
    "test:hardening": "node tests/hardening.test.mjs",
    "test:imports": "node tests/check-imports.mjs",
    "test:links": "node scripts/check-links.mjs",
    "test:secrets": "node tests/check-secrets.mjs",
    "test:exposure": "node tests/secret-exposure.test.mjs",
    "test:filenames": "node tests/filename-policy.test.mjs",
    "test:smoke": "playwright test",
    "test:references": "node tests/reference-minter.test.mjs",
    "test:categories": "node tests/categories.test.mjs",
    "test:register": "node tests/executive-register.test.mjs",
    "test:normalizer": "node tests/source-normalizer.test.mjs",
    "test:flags": "node tests/document-flags.test.mjs",
    "test:entrypoints": "node tests/entry-points.test.mjs",
    "test:triage": "node tests/intake-triage.test.mjs",
    "visual": "node scripts/visual-docs-data.mjs --write",
    "test:visual": "node tests/visual-docs.test.mjs",
    "architecture": "node scripts/architecture-data.mjs --write",
    "test:architecture": "node tests/architecture.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "http-server": "^14.1.1",
    "linkinator": "^6.1.2",
    "puppeteer-core": "^25.4.0"
  }
}
