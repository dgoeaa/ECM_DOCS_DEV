{
  "name": "dgo-r11-ui-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "DGO R11.6 runtime UI contracts, Playwright smoke tests, and dev-server tooling.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "http-server . -p 8080 --cors -c-1 --silent",
    "dev": "node scripts/dev-server.mjs",
    "dev:reset": "node scripts/dev-server.mjs --reset",
    "setup": "node scripts/setup.mjs",
    "go": "npm run setup && npm start",
    "serve:portal": "http-server document-portal -p 8080 --cors -c-1 --silent",
    "commission": "node scripts/commission-check.mjs",
    "recover": "node scripts/setup.mjs --recover --force",
    "verify:endpoints": "node scripts/verify-endpoints.mjs",
    "test": "npm run test:imports && npm run test:refs && npm run test:secrets && npm run test:exposure && npm run test:governance && npm run test:encoding && npm run test:tokens && npm run test:breakpoints && npm run test:statuses && npm run test:hardening && npm run test:references && npm run test:categories && npm run test:filenames && npm run test:portability && npm run test:packaging && npm run test:register && npm run test:normalizer && npm run test:flags && npm run test:entrypoints && npm run test:triage && npm run test:visual && npm run test:architecture && npm run test:auth && npm run test:identity && npm run test:roles && npm run test:commissioning && npm run test:verification && npm run test:devserver && npm run test:smoke",
    "test:commissioning": "node tests/commissioning.test.mjs",
    "test:identity": "node tests/identity-directory.test.mjs",
    "test:roles": "node scripts/role-catalogue-seed.mjs --check",
    "seed:roles": "node scripts/role-catalogue-seed.mjs",
    "test:auth": "node tests/auth-posture.test.mjs",
    "test:devserver": "node tests/dev-server.test.mjs",
    "test:encoding": "node tests/output-encoding.test.mjs",
    "test:tokens": "node tests/design-tokens.test.mjs",
    "test:breakpoints": "node tests/breakpoint-scale.test.mjs",
    "test:statuses": "node tests/status-vocabulary.test.mjs",
    "test:governance": "node tests/governance.test.mjs",
    "test:hardening": "node tests/hardening.test.mjs",
    "test:imports": "node tests/check-imports.mjs",
    "test:links": "node scripts/check-links.mjs",
    "test:secrets": "node tests/check-secrets.mjs",
    "test:exposure": "node tests/secret-exposure.test.mjs",
    "test:filenames": "node tests/filename-policy.test.mjs",
    "test:portability": "node tests/package-portability.test.mjs",
    "test:smoke": "playwright test",
    "test:references": "node tests/reference-minter.test.mjs",
    "test:categories": "node tests/categories.test.mjs",
    "test:register": "node tests/executive-register.test.mjs",
    "test:normalizer": "node tests/source-normalizer.test.mjs",
    "test:flags": "node tests/document-flags.test.mjs",
    "test:entrypoints": "node tests/entry-points.test.mjs",
    "test:triage": "node tests/intake-triage.test.mjs",
    "visual": "node scripts/visual-docs-data.mjs --write",
    "test:visual": "node tests/visual-docs.test.mjs",
    "architecture": "node scripts/architecture-data.mjs --write",
    "test:architecture": "node tests/architecture.test.mjs",
    "package": "node scripts/package.mjs",
    "package:verify": "node scripts/package.mjs",
    "test:packaging": "node tests/packaging.test.mjs",
    "test:refs": "node tests/references.test.mjs",
    "rotation": "node scripts/rotation-register.mjs",
    "package:bundle": "node scripts/package-bundle.mjs",
    "test:verification": "node tests/endpoint-verification.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "http-server": "^14.1.1",
    "linkinator": "^8.0.3",
    "puppeteer-core": "^25.4.0"
  }
}
