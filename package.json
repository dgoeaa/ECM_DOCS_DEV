{
  "name": "dgo-r11-ui-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "DGO R11.6 runtime UI contracts, Playwright smoke tests, and dev-server tooling.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "http-server . -p 8080 --cors -c-1 --silent",
    "start:proxy": "node proxy/src/server.js",
    "test": "npm run test:imports && npm run test:secrets && npm run test:exposure && npm run test:governance && npm run test:encoding && npm run test:hardening && npm run test:references && npm run test:categories && npm run test:filenames && npm run test:register && npm run test:architecture && npm run test:auth && npm run test:proxy && npm run test:intake && npm run test:upload && npm run test:status && npm run test:scan && npm run test:verify && npm run test:worker && npm run test:refstore && npm run test:smoke",
    "test:auth": "node tests/auth-posture.test.mjs",
    "test:encoding": "node tests/output-encoding.test.mjs",
    "test:governance": "node tests/governance.test.mjs",
    "test:hardening": "node tests/hardening.test.mjs",
    "test:imports": "node tests/check-imports.mjs",
    "test:links": "node scripts/check-links.mjs",
    "test:intake": "node proxy/test/intake.test.mjs",
    "test:upload": "node proxy/test/upload.test.mjs",
    "test:proxy": "node proxy/test/proxy.test.mjs",
    "test:secrets": "node tests/check-secrets.mjs",
    "test:exposure": "node tests/secret-exposure.test.mjs",
    "test:filenames": "node tests/filename-policy.test.mjs",
    "test:smoke": "playwright test",
    "test:status": "node proxy/test/status.test.mjs",
    "test:scan": "node proxy/test/scan.test.mjs",
    "test:references": "node tests/reference-minter.test.mjs",
    "test:categories": "node tests/categories.test.mjs",
    "test:register": "node tests/executive-register.test.mjs",
    "architecture": "node scripts/architecture-data.mjs --write",
    "test:architecture": "node tests/architecture.test.mjs",
    "test:refstore": "node proxy/test/reference-store.test.mjs",
    "test:worker": "node proxy/test/worker.test.mjs",
    "test:verify": "node proxy/test/verification.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "http-server": "^14.1.1",
    "linkinator": "^6.1.2",
    "puppeteer-core": "^25.4.0"
  }
}
