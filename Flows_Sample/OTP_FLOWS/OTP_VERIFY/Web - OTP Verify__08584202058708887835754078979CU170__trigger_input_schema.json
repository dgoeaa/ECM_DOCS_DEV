{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","title":"Standardized Trigger Contract","description":"Self-contained HTTP trigger schema. Includes the standard shared trigger fields and the flow-specific field.","properties":{"action":{"type":["string","null"],"minLength":1,"description":"The high-level action to perform."},"operation":{"type":["string","null"],"minLength":1,"description":"The specific operation name."},"mode":{"type":["string","null"],"description":"Execution mode for the request."},"source":{"type":["string","null"],"description":"Source system initiating the request."},"userEmail":{"type":["string","null"],"format":"email","description":"The initiating user's email address."},"method":{"type":["string","null"],"description":"Request or execution method."},"id":{"type":["string","integer","null"],"description":"Primary identifier associated with the request."},"device":{"type":["object","null"],"description":"Device information related to the request.","properties":{"id":{"type":["string","integer","null"],"description":"Device identifier."}},"additionalProperties":true},"otp_code":{"type":"string","description":"Required only for verification"},"channel":{"type":"string","description":"Optional: delivery method, e.g. 'sms' or 'email'"},"request_id":{"type":"string","description":"Optional: unique transaction identifier"}},"required":[],"additionalProperties":true,"x-backward-compatible":true,"x-compatibility-note":"Shared and flow-specific trigger fields are fully built into this single schema without external references."}